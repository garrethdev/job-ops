# job-ops local environment — COMMITTED TEMPLATE (no real values).
# Copy to `.env` (gitignored) and fill in. Auto-loaded by core/config.py for
# local runs; in GitHub Actions these come from repo Secrets instead, and real
# environment values always override this file.

# --- Scoring (Module B / web-checker) ---------------------------------------
# LLM scoring provider priority (used with `--llm`): OpenRouter first, then
# Anthropic, else the FREE deterministic heuristic. All are BILLED when used.

# OpenRouter (DeepSeek-V3). ~$0.03 to score a full ~144-job run.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324

# Anthropic (Claude) — alternative LLM scorer if no OpenRouter key.
ANTHROPIC_API_KEY=

# Optional. Only needed for JS-rendered sources via Firecrawl (none configured yet).
FIRECRAWL_API_KEY=

# --- Module A (email-scanner) — BLOCKED until these exist -------------------
# OAuth for the gmail.com account (garreth.dottin@gmail.com), NOT cryptomiami.net.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Module C (contact-enricher) — BLOCKED until this exists ---------------
APOLLO_API_KEY=

# --- Tuning (optional; have sensible defaults) ------------------------------
# Fit score at/above which an opportunity is surfaced in the digest (default 6).
JOBOPS_FIT_THRESHOLD=6
# Per-run Apollo lookup cap to bound credit spend (default 25).
JOBOPS_APOLLO_MAX_LOOKUPS=25
